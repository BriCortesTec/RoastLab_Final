meta {
  name: Login admin (obtiene token JWT)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@roastlab.site",
    "password": "{{passwordAdmin}}"
  }
}

script:post-response {
  bru.setEnvVar("tokenAdmin", res.body.token);
}

assert {
  res.status: eq 200
}

tests {
  test("devuelve un JWT y el rol admin", function() {
    expect(res.body.token).to.be.a("string");
    expect(res.body.user.role).to.equal("admin");
  });
}
