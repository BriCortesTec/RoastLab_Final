meta {
  name: Prueba de WhatsApp (configura whatsappTo con un número real autorizado)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/notificaciones/prueba
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "channel": "whatsapp",
    "to": "{{whatsappTo}}",
    "message": "Prueba WhatsApp desde RoastLab"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq ENVIADO
}
